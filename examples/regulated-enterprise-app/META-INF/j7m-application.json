{
  "schemaVersion": "j7m.application/v1",
  "application": {
    "group": "org.j7m.examples",
    "name": "regulated-enterprise-app",
    "version": "1.0.0",
    "displayName": "Regulated Enterprise App",
    "description": "Deployable local compliance evidence and posture example"
  },
  "runtime": {
    "minJ7mVersion": "0.5.6",
    "javaVersion": "25",
    "moduleMode": "CLASSPATH",
    "bootstrapClass": "org.j7m.middleware.examples.regulated.RegulatedEnterpriseApplication"
  },
  "services": [
    {
      "serviceName": "//apps/example/regulated/EnterpriseService",
      "interfaceName": "org.j7m.middleware.examples.regulated.RegulatedEnterpriseService",
      "implementationClass": "org.j7m.middleware.examples.regulated.RegulatedEnterpriseServiceImpl",
      "transport": "grpc",
      "globallyExported": true,
      "metadata": {
        "domain": "example",
        "classification": "regulated-demo",
        "example": "regulated-enterprise-app",
        "sbom": "present",
        "provenance": "present"
      }
    }
  ],
  "security": {
    "trustDomain": "dev",
    "confidential": true
  },
  "resources": {
    "cpu": "1",
    "memory": "256MiB",
    "maxConcurrentInvocations": 8,
    "maxInboundPayload": "1MiB"
  }
}
