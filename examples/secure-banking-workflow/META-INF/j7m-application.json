{
  "schemaVersion": "j7m.application/v1",
  "application": {
    "group": "org.j7m.examples",
    "name": "secure-banking-workflow",
    "version": "1.0.0",
    "displayName": "Secure Banking Workflow",
    "description": "Security pattern demo for authorization, caller identity, and redaction"
  },
  "runtime": {
    "minJ7mVersion": "0.5.5",
    "javaVersion": "25",
    "moduleMode": "CLASSPATH",
    "bootstrapClass": "org.j7m.middleware.examples.hello.HelloApplication"
  },
  "services": [
    {
      "serviceName": "//apps/example/banking/ApprovalService",
      "interfaceName": "org.j7m.middleware.examples.banking.BankingApprovalService",
      "implementationClass": "org.j7m.middleware.examples.banking.BankingApprovalServiceImpl",
      "transport": "grpc",
      "globallyExported": true,
      "metadata": {
        "domain": "example",
        "classification": "confidential",
        "example": "secure-banking-workflow"
      }
    }
  ],
  "security": {
    "trustDomain": "dev",
    "confidential": true
  },
  "resources": {
    "cpu": "1",
    "memory": "256MiB",
    "maxConcurrentInvocations": 16,
    "maxInboundPayload": "1MiB"
  }
}
