{
  "schemaVersion": "j7m.application/v1",
  "application": {
    "group": "org.j7m.examples",
    "name": "callbacks-and-events",
    "version": "1.0.0",
    "displayName": "Callbacks And Events",
    "description": "Callback reference example for gRPC and RMI semantics"
  },
  "runtime": {
    "minJ7mVersion": "0.5.5",
    "javaVersion": "25",
    "moduleMode": "CLASSPATH",
    "bootstrapClass": "org.j7m.examples.events.EventServiceImpl"
  },
  "services": [
    {
      "serviceName": "//apps/example/events/EventService",
      "interfaceName": "org.j7m.examples.events.EventService",
      "implementationClass": "org.j7m.examples.events.EventServiceImpl",
      "transport": "grpc",
      "globallyExported": true,
      "metadata": {
        "domain": "example",
        "classification": "internal",
        "example": "callbacks-and-events"
      }
    }
  ],
  "security": {
    "trustDomain": "dev",
    "confidential": false
  },
  "resources": {
    "cpu": "1",
    "memory": "256MiB",
    "maxConcurrentInvocations": 32,
    "maxInboundPayload": "4MiB"
  }
}
